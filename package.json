{
  "name": "aperture",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-native, privacy-first web browser. Built to be driven by agents over MCP.",
  "author": "Brad Cunningham",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder",
    "bench": "node bench/tokens.mjs",
    "bench:fidelity": "node bench/fidelity.mjs",
    "bench:guards": "node bench/guards.mjs",
    "bench:task": "node bench/task.mjs",
    "bench:size": "node bench/size.mjs",
    "bench:h2h": "node bench/headtohead/h2h.mjs",
    "bench:live": "node bench/live.mjs",
    "bench:darkmode": "node bench/darkmode.mjs"
  },
  "build": {
    "appId": "dev.aperture.browser",
    "productName": "Aperture",
    "afterPack": "build/afterPack.cjs",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "hardenedRuntime": true
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@ghostery/adblocker-electron": "^2.18.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "tldts": "^7.4.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@electron/fuses": "^2.1.3",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^24.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
